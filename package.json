{
  "name": "careerignite",
  "version": "1.0.0",
  "description": "REST API for managing internship and early-career opportunities, applicants and their documents.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "user:create": "node scripts/createUser.js",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "keywords": ["internships", "careers", "opportunities", "prisma", "postgresql", "rest-api"],
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "prisma": "^6.9.0"
  },
  "dependencies": {
    "@faker-js/faker": "^9.8.0",
    "@prisma/client": "^6.9.0"
  }
}
