# --- Database (PostgreSQL) -----------------------------------------------------
# Matches docker-compose.yml. Change the credentials for anything but local dev.
DATABASE_URL="postgresql://careerignite:careerignite@localhost:5432/careerignite?schema=public"

# --- Server --------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Auth ----------------------------------------------------------------------
# REQUIRED in production, min 32 chars.  Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Token lifetime: 30m, 12h, 7d ... (default 1h)
JWT_EXPIRES_IN=1h

# Login/register brute-force protection (per IP): max requests per window
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW=15m

# --- HTTP ----------------------------------------------------------------------
# Comma-separated allowed browser origins, or * for any. Empty = no CORS headers.
CORS_ORIGIN=http://localhost:5173
# Set to true ONLY when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# --- Uploads -------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# --- Seeding (npm run db:seed) -------------------------------------------------
SEED_ADMIN_EMAIL=admin@careerignite.local
SEED_ADMIN_PASSWORD=ChangeMe123!
